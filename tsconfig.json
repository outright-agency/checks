{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": [
      "es2023"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "actions",
    "bin",
    "src",
    "test",
    "scripts",
    "*.mjs"
  ],
  "exclude": [
    "test/installed/app"
  ]
}
